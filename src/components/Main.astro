---
import '../styles/global.css';
import "@fontsource/vt323";
import "@fontsource/jetbrains-mono";
---
<div id="container" class="w-screen h-screen flex justify-center items-center">
	<div id="main" class="w-450 h-230 bg-gradient-to-r from-green-200 to-blue-300 rounded-3xl m-auto mt-5 flex flex-col items-center p-10 shadow-lg">
		<h1 style="font-family: 'VT323', monospace; font-style: normal; font-weight: 400;" class="text-6xl font-bold mb-6 text-black">NekoPlumi</h1>
		
		<div id="blog1">
			<p id="SubmitBTN" class="bg-white text-black font-mono font-semibold py-2 px-4 rounded-full shadow-md hover:bg-gray-200 transition duration-300">
				Generate Blog Posts
			</p>
		</div>
		
		<div id="blog2" class="mt-6 text-center">
			<p class="text-black font-mono">Click the button to create a new blog post!</p>
		</div>

		<div id="blog3">
			<input id="titleInput" type="text" placeholder="Enter blog title..." class="mt-6 p-2 rounded border border-gray-300 w-64 text-black font-mono" />
			<input id="bodyInput" type="text" placeholder="Enter blog content..." class="mt-4 p-2 rounded border border-gray-300 w-64 text-black font-mono" />
			<button id="submitBTN" class="bg-white text-black font-mono font-semibold py-2 px-4 rounded-full shadow-md hover:bg-gray-200 transition duration-300">Submit</button>
		</div>
		
		<!-- FOR EACH ENTRY -->
		<div id="entries" class="mt-6 flex flex-wrap gap-6 justify-center w-full" style="display: none;"></div>
	</div>
</div>
<footer class="fixed bottom-2 w-full text-center text-gray-500 font-mono">
	Created by Iker with love ❤️
</footer>


<style>
	body{
		background-color: rgb(253, 253, 253);
	}
</style>
<script src="../script/main.js"></script>
